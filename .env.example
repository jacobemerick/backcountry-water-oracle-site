# Copy to .env.local and fill in. .env.local is gitignored.

# Neon Postgres connection string, from the Neon console (use the POOLED
# connection for the app; either works for migrations).
# Must include ?sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require"
